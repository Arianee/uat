{
  "name": "@arianee/uat",
  "version": "2.55.0",
  "description": "End-to-end (UAT) testing with Gherkin + Playwright: ready-to-use Cucumber steps for Chromium, Firefox and WebKit",
  "main": "dist",
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "postpublish": "npm version minor -m 'feat(version): update to version %s [ci skip]' && git push",
    "build": "tsc",
    "build:w": "tsc --watch",
    "test": "npm run test:unit && npm run test:e2e",
    "server": "http-server ./www --port 4200",
    "test:unit": "jest",
    "test:e2e": "node index.bin.js ./features/**.feature",
    "e2e:dev": "headless=false npm run test:e2e -- --tags @dev"
  },
  "bin": {
    "uat": "index.bin.js"
  },
  "files": [
    "common_steps",
    "features",
    "script.js"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cucumber/cucumber": "~7.3.2",
    "@cucumber/pretty-formatter": "1.0.1",
    "@slack/web-api": "^7.19.0",
    "faker": "~5.5.3",
    "form-data": "^3.0.5",
    "http-server": "^14.1.1",
    "kill-port": "^2.0.1",
    "lodash": "^4.18.1",
    "node-fetch": "^2.7.0",
    "onecolor": "^3.1.0",
    "playwright": "~1.55.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^18.19.0",
    "@types/node-fetch": "^2.6.13",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
