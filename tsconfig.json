{
  "compilerOptions": {
    "experimentalDecorators": true,
    "outDir": "./common_steps",
    "noImplicitAny": false,
    "sourceMap": true,
    "declaration": true,
    "target": "es2019",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "lib": [
      "es2019",
      "dom"
    ],
    "baseUrl": "src",
    "module": "commonjs"
  },
  "exclude": [
    "src/**/*.test.ts"
  ],
  "include": [
    "src"
  ]
}
